# Copy to .env and fill in. .env is gitignored.

# Postgres (matches docker-compose.yml; host port 5433 to avoid clashing with a local PG)
DATABASE_URL=postgresql+psycopg://asteria:asteria@localhost:5433/asteria

# Anthropic — the capture bots and both analysis tiers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Where the generated company lives, relative to repo root
MOCK_COMPANY_DIR=mock-company

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Google Sheets — the live register surface. See plan/SHEETS.md.
# The key is a service-account JSON file that lives OUTSIDE the repo and is never
# committed. Ask Tanat for it; point this at wherever you put it.
REGISTER_SHEETS_CREDENTIALS=

# One spreadsheet per register workbook. A pasted sheet URL works as well as a bare id.
# Each must be shared as Editor with capture-agent@pms-agent-508511.iam.gserviceaccount.com
SHEET_COMPLAINT_REGISTER=
SHEET_CLIENT_COMMUNICATIONS_LOG=
SHEET_CUSTOMER_ORGANISATIONS_AND_HUBS=
SHEET_DATA_CHECK_AND_TROUBLESHOOTING_LOG=
SHEET_INCIDENT_AND_OUTAGE_LOG=
SHEET_PMS_PLAN_AND_REPORT_REGISTER=
SHEET_PRODUCT_RETURN_AND_REPLACEMENT_REGISTER=
