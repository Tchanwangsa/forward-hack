  "schema_version": "1.0.0",
  "purpose": "Supplies the 'except Federal holidays' term of 21 CFR 803.3(y): \"Work day means Monday through Friday, except Federal holidays.\" Used for the 5-work-day clocks of 803.53(a) and 803.53(b). It is NOT used for the 30-calendar-day clock of 803.50, which counts calendar days and has no roll-forward rule.",
  "weekend_substitution_rule": {
    "applies": true,
    "statement": "Under 5 U.S.C. 6103(b), when a federal holiday falls on a Saturday the preceding Friday is treated as the holiday, and when it falls on a Sunday the following Monday is. The `date` field below is always the OBSERVED date — the day federal offices are closed — because that is the day 803.3(y) removes from the work-day count. `actual_date` records the statutory date where the two differ.",
    "source": "opm-federal-holidays"
  },
